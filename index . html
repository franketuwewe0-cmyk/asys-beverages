<script>
(function(){
  const header = document.getElementById('siteHeader');
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, {passive:true});

  const burger = document.getElementById('burgerBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  burger.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('open');
    burger.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    mobileMenu.classList.remove('open');
    burger.classList.remove('open');
    document.body.style.overflow = '';
  }));

  const revealEls = document.querySelectorAll('.reveal, .reveal-stag');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold: 0.12});
  revealEls.forEach(el => io.observe(el));

  /* Add products below in this format:
     {name:"Item Name", desc:"Short description.", img:"IMAGE_LINK", price:"₦0,000", pack:"500g" or "1 Litre" etc}, */
  const items = [
    {name:"Ginger Drink", desc:"Bold, spicy-sweet ginger drink, naturally refreshing.", price:"₦1,000", pack:"35cl Bottle", img:"https://i.postimg.cc/PqyZZZGj/image.png", cats:["drinks"]},
    {name:"Zobo Drink", desc:"Classic hibiscus zobo, deep in color and flavor.", price:"₦1,000", pack:"35cl Bottle", img:"https://i.postimg.cc/Y0WhXLPB/image.png", cats:["drinks"]},
    {name:"Tamarind Drink", desc:"Tangy-sweet tamarind, a refreshing house favorite.", price:"₦1,000", pack:"35cl Bottle", img:"https://i.postimg.cc/mDqwnqbT/image.png", cats:["drinks"]},
    {name:"Baobab Drink", desc:"Smooth and tangy, made from real baobab fruit.", price:"₦1,000", pack:"35cl Bottle", img:"https://i.postimg.cc/VvnjVkGF/image.png", cats:["drinks"]},
    {name:"Tigernut Drink", desc:"Creamy, naturally sweet tigernut milk drink.", price:"₦1,200", pack:"35cl Bottle", img:"https://i.postimg.cc/DyhszFYs/image.png", cats:["drinks"]},
    {name:"Millet Drink", desc:"Light and wholesome millet drink.", price:"₦500", pack:"35cl Bottle", img:"https://i.postimg.cc/RZN0SD9t/image.png", cats:["drinks"]},
    {name:"Plain Yoghurt", desc:"Creamy &amp; Delicious.", price:"₦4,500", pack:"1 Litre Tub", img:"https://i.postimg.cc/pLkSsjCY/image.png", cats:["yoghurt"]},
    {name:"Plain Yoghurt", desc:"Creamy &amp; Delicious.", price:"₦2,500", pack:"500ml Bottle", img:"https://i.postimg.cc/pXCkvHFq/image.png", cats:["yoghurt"]},
    {name:"Yogo Fura", desc:"Traditional Taste, Perfect Blend.", price:"₦3,000 – ₦5,500", pack:"500ml / 1 Litre Tub", img:"https://i.postimg.cc/BvnT4YFM/image.png", cats:["yoghurt"]},
    {name:"Greek Yoghurt", desc:"Thick, Creamy &amp; Nutritious.", price:"₦7,500", pack:"1 Litre Tub", img:"https://i.postimg.cc/PxmrchxG/image.png", cats:["yoghurt"]},
    {name:"Minis", desc:"Perfect On The Go!", price:"₦1,500", pack:"250ml", img:"https://i.postimg.cc/tgqsHKFc/image.png", cats:["yoghurt"]}
  ];

  const grid = document.getElementById('menuGrid');
  function renderTab(tab){
    grid.innerHTML = '';
    grid.classList.remove('in');
    const filtered = items.filter(i => i.cats.includes(tab));
    if (filtered.length === 0) {
      grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--dark-soft);font-size:14px;">Products coming soon — check back shortly!</p>';
      return;
    }
    filtered.forEach(item => {
      const card = document.createElement('div');
      card.className = 'item-card';
      const media = item.img
        ? `<img src="${item.img}" alt="${item.name}">`
        : `<div class="ph-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-5-4-4 3-3-2-6 5"/></svg><span>Photo Coming Soon</span></div>`;
      card.innerHTML = `
        <div class="item-media">${media}</div>
        <div class="item-body">
          <h3>${item.name}</h3>
          <p>${item.desc}</p>
          <div class="price-row">
            <span class="price-tag">${item.price}</span>
            ${item.pack ? `<span class="pack-note">${item.pack}</span>` : ''}
          </div>
        </div>`;
      grid.appendChild(card);
    });
    requestAnimationFrame(() => requestAnimationFrame(() => grid.classList.add('in')));
  }
  document.getElementById('tabBar').addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderTab(btn.dataset.tab);
  });
  renderTab('yoghurt');
})();
</script>
